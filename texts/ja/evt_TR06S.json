    "translation": "[#P04]お伝えします",
    "speaker": "インフォ"
  },
  {
    "index": 3,
    "key": "evt_TR06S_0003",
    "original": "[#P04]１：“ハルヒメーター”について",
    "translation": "[#P04]１：“ハルヒメーター”について",
