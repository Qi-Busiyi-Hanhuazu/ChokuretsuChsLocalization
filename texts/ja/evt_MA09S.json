  },
  {
    "index": 9,
    "key": "evt_MA09S_0009",
    "original": "にゃぁ",
    "translation": "にゃぁ",
    "speaker": "野良猫"
  },
  {
    "index": 10,
    "key": "evt_MA09S_0010",
    "original": "この子、すごく人なつっこいわ\nよしよし……お腹空いてるのかしら",
    "translation": "この子、すごく人なつっこいわ\nよしよし……お腹空いてるのかしら",
    "speaker": "ハルヒ"
  },
  {
    "index": 11,
    "key": "evt_MA09S_0011",
    "original": "ねえ、キョン\n何か食べ物持ってない？",
    "translation": "ねえ、キョン\n何か食べ物持ってない？",
    "speaker": "ハルヒ"
  },
  {
    "index": 12,
    "key": "evt_MA09S_0012",
    "original": "運が良く時間稼ぎができたな\nのら猫の恩返しってところか",
    "translation": "運が良く時間稼ぎができたな\nのら猫の恩返しってところか",
    "speaker": "モノロ"
  },
  {
    "index": 13,
    "key": "evt_MA09S_0013",
    "original": "みくるちゃん、走るわよ",
    "translation": "みくるちゃん、走るわよ",
