    "translation": "にゃぁあ",
    "speaker": "野良猫"
  },
  {
    "index": 20,
    "key": "evt_MA09S_0020",
    "original": "ひゃっ、ふふふ……そんなに舐め\nないでください",
    "translation": "ひゃっ、ふふふ……そんなに舐め\nないでください",
    "speaker": "みくる"
  },
  {
    "index": 21,
    "key": "evt_MA09S_0021",
    "original": "みくるちゃん、ずいぶん気に入られ\nたみたいね",
    "translation": "みくるちゃん、ずいぶん気に入られ\nたみたいね",
    "speaker": "ハルヒ"
  },
  {
    "index": 22,
    "key": "evt_MA09S_0022",
    "original": "はい。すごく可愛いです",
    "translation": "はい。すごく可愛いです",
