[
  {
    "index": 0,
    "key": "evt_MA09S_0000",
    "original": "やだ、もうこんな時間じゃない\nちょっとグズグズしすぎたわ",
    "translation": "やだ、もうこんな時間じゃない\nちょっとグズグズしすぎたわ",
    "speaker": "ハルヒ"
  },
  {
    "index": 1,
    "key": "evt_MA09S_0001",
    "original": "はいキョン、あんた荷物持って",
    "translation": "はいキョン、あんた荷物持って",
    "speaker": "ハルヒ"
  },
  {
    "index": 2,
    "key": "evt_MA09S_0002",
    "original": "おい、なんなんだよ。こんなもの\n何に使うんだ？",
    "translation": "おい、なんなんだよ。こんなもの\n何に使うんだ？",
    "speaker": "キョン"
  },
  {
    "index": 3,
    "key": "evt_MA09S_0003",
    "original": "いいから、ダッシュよダッシュ\n体育館へ急ぐわよ",
    "translation": "いいから、ダッシュよダッシュ\n体育館へ急ぐわよ",
    "speaker": "ハルヒ"
  },
  {
    "index": 4,
    "key": "evt_MA09S_0004",
    "original": "にゃ～～",
    "translation": "にゃ～～",
    "speaker": "野良猫"
  },
  {
    "index": 5,
    "key": "evt_MA09S_0005",
    "original": "なに？　今の……",
    "translation": "なに？　今の……",
    "speaker": "ハルヒ"
  },
  {
    "index": 6,
    "key": "evt_MA09S_0006",
    "original": "にゃぁ",
    "translation": "にゃぁ",
    "speaker": "野良猫"
  },
  {
    "index": 7,
    "key": "evt_MA09S_0007",
    "original": "やだ、猫じゃない",
    "translation": "やだ、猫じゃない",
    "speaker": "ハルヒ"
  },
  {
    "index": 8,
    "key": "evt_MA09S_0008",
    "original": "あれは、昼間商店街で見かけた猫か\nもしかしてここまで着いて来た？",
    "translation": "あれは、昼間商店街で見かけた猫か\nもしかしてここまで着いて来た？",
