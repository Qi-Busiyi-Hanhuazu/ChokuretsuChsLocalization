  },
  {
    "index": 68,
    "key": "evt_MA09S_0068",
    "original": "これは、少しは時間稼ぎになったで\nしょうか",
    "translation": "これは、少しは時間稼ぎになったで\nしょうか",
    "speaker": "古泉"
  }
