[
  {
    "index": 0,
    "key": "evt_MA02S_0000",
    "original": "あ、部長さんじゃない",
    "translation": "あ、部長さんじゃない",
    "speaker": "ハルヒ"
  },
  {
    "index": 1,
    "key": "evt_MA02S_0001",
    "original": "団長さんか……",
    "translation": "団長さんか……",
    "speaker": "部長氏"
  },
  {
    "index": 2,
    "key": "evt_MA02S_0002",
    "original": "ねえ、何か変わったことなかった？",
    "translation": "ねえ、何か変わったことなかった？",
    "speaker": "ハルヒ"
  },
  {
    "index": 3,
    "key": "evt_MA02S_0003",
    "original": "変わったこと？",
    "translation": "変わったこと？",
    "speaker": "部長氏"
  },
  {
    "index": 4,
    "key": "evt_MA02S_0004",
    "original": "ああ、廊下の向こうが\nやけに騒がしかったけど……",
    "translation": "ああ、廊下の向こうが\nやけに騒がしかったけど……",
    "speaker": "部長氏"
  },
  {
    "index": 5,
    "key": "evt_MA02S_0005",
    "original": "なんですって！？",
    "translation": "なんですって！？",
    "speaker": "ハルヒ"
  },
  {
    "index": 6,
    "key": "evt_MA02S_0006",
    "original": "",
    "translation": "",
    "speaker": "部長氏",
    "trash": true
  },
  {
    "index": 7,
    "key": "evt_MA02S_0007",
    "original": "ん……？",
    "translation": "ん……？",
    "speaker": "ハルヒ"
  },
  {
    "index": 8,
    "key": "evt_MA02S_0008",
    "original": "涼宮さん、どうしたんですか？",
    "translation": "涼宮さん、どうしたんですか？",
    "speaker": "みくる"
  },
  {
    "index": 9,
    "key": "evt_MA02S_0009",
    "original": "あそこにいるの、コンピ研の連中\nじゃない？",
    "translation": "あそこにいるの、コンピ研の連中\nじゃない？",
    "speaker": "ハルヒ"
  },
  {
    "index": 10,
    "key": "evt_MA02S_0010",
    "original": "あ、そうですね",
    "translation": "あ、そうですね",
    "speaker": "みくる"
  },
  {
    "index": 11,
    "key": "evt_MA02S_0011",
    "original": "ちょっとあんたたち！",
    "translation": "ちょっとあんたたち！",
    "speaker": "ハルヒ"
  },
  {
    "index": 12,
    "key": "evt_MA02S_0012",
    "original": "そんなところでコソコソと\nなにやってるの！？",
    "translation": "そんなところでコソコソと\nなにやってるの！？",
    "speaker": "ハルヒ"
  },
  {
    "index": 13,
    "key": "evt_MA02S_0013",
    "original": "",
    "translation": "",
    "speaker": "みくる",
    "trash": true
  },
  {
    "index": 14,
    "key": "evt_MA02S_0014",
    "original": "し、しまった見られた！？",
    "translation": "し、しまった見られた！？",
    "speaker": "部員Ａ"
  },
  {
    "index": 15,
    "key": "evt_MA02S_0015",
    "original": "怪しいわね、今隠したものを\n差し出しなさい！",
    "translation": "怪しいわね、今隠したものを\n差し出しなさい！",
    "speaker": "ハルヒ"
  },
  {
    "index": 16,
    "key": "evt_MA02S_0016",
    "original": "う……",
    "translation": "う……",
    "speaker": "部員Ａ"
  },
  {
    "index": 17,
    "key": "evt_MA02S_0017",
    "original": "ほら、早く！",
    "translation": "ほら、早く！",
    "speaker": "ハルヒ"
  },
  {
    "index": 18,
    "key": "evt_MA02S_0018",
    "original": "こ、これだよ……",
    "translation": "こ、これだよ……",
    "speaker": "部員Ａ"
  },
  {
    "index": 19,
    "key": "evt_MA02S_0019",
    "original": "なにこれ？",
    "translation": "なにこれ？",
    "speaker": "ハルヒ"
  },
  {
    "index": 20,
    "key": "evt_MA02S_0020",
    "original": "節水を呼びかける貼り紙さ",
    "translation": "節水を呼びかける貼り紙さ",
    "speaker": "部員Ａ"
  },
  {
    "index": 21,
    "key": "evt_MA02S_0021",
    "original": "うちが生徒会から委託をうけたんだ",
    "translation": "うちが生徒会から委託をうけたんだ",
    "speaker": "部員Ａ"
  },
  {
    "index": 22,
    "key": "evt_MA02S_0022",
    "original": "ふーん……\nで、なんで貼り替えてるわけ？",
    "translation": "ふーん……\nで、なんで貼り替えてるわけ？",
    "speaker": "ハルヒ"
  },
  {
    "index": 23,
    "key": "evt_MA02S_0023",
    "original": "それは、ちょっとミスが……",
    "translation": "それは、ちょっとミスが……",
    "speaker": "部員Ａ"
  },
  {
    "index": 24,
    "key": "evt_MA02S_0024",
    "original": "ミスってこれね？",
    "translation": "ミスってこれね？",
    "speaker": "ハルヒ"
  },
  {
    "index": 25,
    "key": "evt_MA02S_0025",
    "original": "なにこれ、字が思いっきり横に伸び\nちゃってるじゃない",
    "translation": "なにこれ、字が思いっきり横に伸び\nちゃってるじゃない",
    "speaker": "ハルヒ"
  },
  {
    "index": 26,
    "key": "evt_MA02S_0026",
    "original": "しかも普通に水って書けばいいのに\nわざわざ『Ｈ２Ｏ』なんて書いて",
    "translation": "しかも普通に水って書けばいいのに\nわざわざ『Ｈ２Ｏ』なんて書いて",
    "speaker": "ハルヒ"
  },
  {
    "index": 27,
    "key": "evt_MA02S_0027",
    "original": "そういうの、やる気が空回りしてる\nって言うのよね",
    "translation": "そういうの、やる気が空回りしてる\nって言うのよね",
    "speaker": "ハルヒ"
  },
  {
    "index": 28,
    "key": "evt_MA02S_0028",
    "original": "う、うわーん！",
    "translation": "う、うわーん！",
    "speaker": "部員Ａ"
  },
  {
    "index": 29,
    "key": "evt_MA02S_0029",
    "original": "あ、泣いちゃった",
    "translation": "あ、泣いちゃった",
    "speaker": "ハルヒ"
  },
  {
    "index": 30,
    "key": "evt_MA02S_0030",
    "original": "まったく、だらしないわね",
    "translation": "まったく、だらしないわね",
    "speaker": "ハルヒ"
  }
]