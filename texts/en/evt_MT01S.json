[
  {
    "key": "evt_MT01S_0000",
    "original": "",
    "translation": "Um, this was on the floor…"
  },
  {
    "key": "evt_MT01S_0001",
    "original": "",
    "translation": "What's this?"
  },
  {
    "key": "evt_MT01S_0002",
    "original": "",
    "translation": "Umm, Kyon said it has computer data in it…"
  },
  {
    "key": "evt_MT01S_0003",
    "original": "",
    "translation": "Computer data?"
  },
  {
    "key": "evt_MT01S_0004",
    "original": "",
    "translation": "Hmm… Oh, it's got computer society written on\nit?"
  },
  {
    "key": "evt_MT01S_0005",
    "original": "",
    "translation": "Y-yes."
  },
  {
    "key": "evt_MT01S_0006",
    "original": "",
    "translation": "It might be something really important, right?"
  },
  {
    "key": "evt_MT01S_0007",
    "original": "",
    "translation": "That's why we should return it right away…"
  },
  {
    "key": "evt_MT01S_0008",
    "original": "",
    "translation": "What are you talking about?!"
  },
  {
    "key": "evt_MT01S_0009",
    "original": "",
    "translation": "We obviously have to check the contents\nfirst!"
  },
  {
    "key": "evt_MT01S_0010",
    "original": "",
    "translation": "Eehh?!"
  },
  {
    "key": "evt_MT01S_0011",
    "original": "",
    "translation": "As if I'd so easily give back such an\ninteresting looking thing!"
  },
  {
    "key": "evt_MT01S_0012",
    "original": "",
    "translation": "I wonder what's on it."
  },
  {
    "key": "evt_MT01S_0013",
    "original": "",
    "translation": "Questionable images, maybe?"
  },
  {
    "key": "evt_MT01S_0014",
    "original": "",
    "translation": "Or maybe—something like a dangerous\ncomputer virus?"
  },
  {
    "key": "evt_MT01S_0015",
    "original": "",
    "translation": "Either way, we've gotten hold of a weakness\nof theirs!"
  },
  {
    "key": "evt_MT01S_0016",
    "original": "",
    "translation": "Um, it might not have anything interesting\ninside, or it might be broken…"
  },
  {
    "key": "evt_MT01S_0017",
    "original": "",
    "translation": "I want to check right away, but first let's\nmeet up with Koizumi and the others."
  }
]