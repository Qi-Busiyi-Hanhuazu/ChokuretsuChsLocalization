[
  {
    "key": "evt_CA02S_0000",
    "original": "",
    "translation": "I went to the computer society earlier."
  },
  {
    "key": "evt_CA02S_0001",
    "original": "",
    "translation": "I see. Was everything okay?"
  },
  {
    "key": "evt_CA02S_0002",
    "original": "",
    "translation": "Eh? Okay?"
  },
  {
    "key": "evt_CA02S_0003",
    "original": "",
    "translation": "You probably awoke some weird feelings inside\nthem, right?"
  },
  {
    "key": "evt_CA02S_0004",
    "original": "",
    "translation": "You know, because you're so cute."
  },
  {
    "key": "evt_CA02S_0005",
    "original": "",
    "translation": "Th-that's not…"
  },
  {
    "key": "evt_CA02S_0006",
    "original": "",
    "translation": "The club president was very kind."
  },
  {
    "key": "evt_CA02S_0007",
    "original": "",
    "translation": "He said the tea I brewed was delicious, and\ndrank the whole thing—"
  },
  {
    "key": "evt_CA02S_0008",
    "original": "",
    "translation": "Listen up, okay Mikuru?"
  },
  {
    "key": "evt_CA02S_0009",
    "original": "",
    "translation": "O-okay."
  },
  {
    "key": "evt_CA02S_0010",
    "original": "",
    "translation": "Most of the time, those types can't resist\ngirls."
  },
  {
    "key": "evt_CA02S_0011",
    "original": "",
    "translation": "If you act nice to that kind of guy, he'll get\nthe wrong idea."
  },
  {
    "key": "evt_CA02S_0012",
    "original": "",
    "translation": "Be more careful."
  },
  {
    "key": "evt_CA02S_0013",
    "original": "",
    "translation": "More careful… Wh-what do you mean by that?!"
  },
  {
    "key": "evt_CA02S_0014",
    "original": "",
    "translation": "I didn't mean anything particularly… I just\nmeant what I said?"
  },
  {
    "key": "evt_CA02S_0015",
    "original": "",
    "translation": "I-I don't understand at all!"
  },
  {
    "key": "evt_CA02S_0016",
    "original": "",
    "translation": "Well, you'll probably be fine… not that I have\nany evidence to back that up."
  },
  {
    "key": "evt_CA02S_0017",
    "original": "",
    "translation": "Waaa! Suzumiya! You're just making me more\nanxious!"
  }
]