[
  {
    "key": "evt_MT02S_0000",
    "original": "",
    "translation": "Hm…?"
  },
  {
    "key": "evt_MT02S_0001",
    "original": "",
    "translation": "What's wrong?"
  },
  {
    "key": "evt_MT02S_0002",
    "original": "",
    "translation": "That's the computer society guys over there,\nright?"
  },
  {
    "key": "evt_MT02S_0003",
    "original": "",
    "translation": "Oh, you're right."
  },
  {
    "key": "evt_MT02S_0004",
    "original": "",
    "translation": "Hey, you guys!"
  },
  {
    "key": "evt_MT02S_0005",
    "original": "",
    "translation": "What are you whispering about over there?!"
  },
  {
    "key": "evt_MT02S_0007",
    "original": "",
    "translation": "Damn it—she saw us?!"
  },
  {
    "key": "evt_MT02S_0008",
    "original": "",
    "translation": "How suspicious. Show me what you're hiding!"
  },
  {
    "key": "evt_MT02S_0009",
    "original": "",
    "translation": "Eek…"
  },
  {
    "key": "evt_MT02S_0010",
    "original": "",
    "translation": "C'mon, quickly!"
  },
  {
    "key": "evt_MT02S_0011",
    "original": "",
    "translation": "Th-this…"
  },
  {
    "key": "evt_MT02S_0012",
    "original": "",
    "translation": "What is it?"
  },
  {
    "key": "evt_MT02S_0013",
    "original": "",
    "translation": "It's a poster raising awareness for water\nconservation."
  },
  {
    "key": "evt_MT02S_0014",
    "original": "",
    "translation": "The student council tasked us with making\nthem."
  },
  {
    "key": "evt_MT02S_0015",
    "original": "",
    "translation": "Hmm… So why are you replacing the ones that\nyou already set up before?"
  },
  {
    "key": "evt_MT02S_0016",
    "original": "",
    "translation": "Well, we made a bit of a mistake…"
  },
  {
    "key": "evt_MT02S_0017",
    "original": "",
    "translation": "By \"mistake,” I take it you mean this, right?"
  },
  {
    "key": "evt_MT02S_0018",
    "original": "",
    "translation": "What even is this? The text is stretched too\nwide, isn't it?"
  },
  {
    "key": "evt_MT02S_0019",
    "original": "",
    "translation": "You could've just wrote \"water,” but you went\nand put \"H?O” instead."
  },
  {
    "key": "evt_MT02S_0020",
    "original": "",
    "translation": "Now that's what I call a wasted effort."
  },
  {
    "key": "evt_MT02S_0021",
    "original": "",
    "translation": "W-waaahhh!"
  },
  {
    "key": "evt_MT02S_0022",
    "original": "",
    "translation": "Oh, he started crying."
  },
  {
    "key": "evt_MT02S_0023",
    "original": "",
    "translation": "Geez, how pathetic."
  }
]