[
  {
    "key": "evt_MA02S_0000",
    "original": "",
    "translation": "Oh, you're the president, right?"
  },
  {
    "key": "evt_MA02S_0001",
    "original": "",
    "translation": "It's the brigade chief…"
  },
  {
    "key": "evt_MA02S_0002",
    "original": "",
    "translation": "Say, you haven't noticed any strange\nhappenings, have you?"
  },
  {
    "key": "evt_MA02S_0003",
    "original": "",
    "translation": "Strange happenings?"
  },
  {
    "key": "evt_MA02S_0004",
    "original": "",
    "translation": "Hmm, well there was a lot of noise coming from\nthe other end of the hallway…"
  },
  {
    "key": "evt_MA02S_0005",
    "original": "",
    "translation": "What?!"
  },
  {
    "key": "evt_MA02S_0007",
    "original": "",
    "translation": "Hm…?"
  },
  {
    "key": "evt_MA02S_0008",
    "original": "",
    "translation": "What's wrong, Suzumiya?"
  },
  {
    "key": "evt_MA02S_0009",
    "original": "",
    "translation": "Those are the computer society guys over\nthere, right?"
  },
  {
    "key": "evt_MA02S_0010",
    "original": "",
    "translation": "Yes, that's right."
  },
  {
    "key": "evt_MA02S_0011",
    "original": "",
    "translation": "Hey, you guys!"
  },
  {
    "key": "evt_MA02S_0012",
    "original": "",
    "translation": "What are you doing over there whispering to\neach other?!"
  },
  {
    "key": "evt_MA02S_0014",
    "original": "",
    "translation": "D-damn it—she saw us?!"
  },
  {
    "key": "evt_MA02S_0015",
    "original": "",
    "translation": "How suspicious. Show me what you're hiding!"
  },
  {
    "key": "evt_MA02S_0016",
    "original": "",
    "translation": "Eek…"
  },
  {
    "key": "evt_MA02S_0017",
    "original": "",
    "translation": "C'mon, right now!"
  },
  {
    "key": "evt_MA02S_0018",
    "original": "",
    "translation": "Th-this…"
  },
  {
    "key": "evt_MA02S_0019",
    "original": "",
    "translation": "What's this?"
  },
  {
    "key": "evt_MA02S_0020",
    "original": "",
    "translation": "It's a poster raising awareness for water\nconservation."
  },
  {
    "key": "evt_MA02S_0021",
    "original": "",
    "translation": "The student council put us in charge of\nmaking them."
  },
  {
    "key": "evt_MA02S_0022",
    "original": "",
    "translation": "Hmm… So why are you replacing them?"
  },
  {
    "key": "evt_MA02S_0023",
    "original": "",
    "translation": "Well, there was a small error…"
  },
  {
    "key": "evt_MA02S_0024",
    "original": "",
    "translation": "By \"error,” I take it you mean this?"
  },
  {
    "key": "evt_MA02S_0025",
    "original": "",
    "translation": "What even is this? The text is stretched too\nwide, isn't it?"
  },
  {
    "key": "evt_MA02S_0026",
    "original": "",
    "translation": "Not to mention you could've just written\n\"water,” but you went and wrote \"H?O.”"
  },
  {
    "key": "evt_MA02S_0027",
    "original": "",
    "translation": "That's what I call a waste of effort."
  },
  {
    "key": "evt_MA02S_0028",
    "original": "",
    "translation": "W-waaahhh!"
  },
  {
    "key": "evt_MA02S_0029",
    "original": "",
    "translation": "Ah, now you're crying."
  },
  {
    "key": "evt_MA02S_0030",
    "original": "",
    "translation": "Geez, how pathetic."
  }
]