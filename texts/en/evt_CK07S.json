[
  {
    "key": "evt_CK07S_0000",
    "original": "",
    "translation": "Koizumi looks pretty tired."
  },
  {
    "key": "evt_CK07S_0001",
    "original": "",
    "translation": "Kyon seemed surprised about it."
  },
  {
    "key": "evt_CK07S_0002",
    "original": "",
    "translation": "Even Koizumi gets tired though, right?"
  },
  {
    "key": "evt_CK07S_0003",
    "original": "",
    "translation": "That's right, but he's not usually one to\ncomplain, so Kyon thought it was strange."
  },
  {
    "key": "evt_CK07S_0004",
    "original": "",
    "translation": "I guess so. Probably because he's always\nsmiling."
  },
  {
    "key": "evt_CK07S_0005",
    "original": "",
    "translation": "I wonder if there are other weird things like\nthat—like Yuki smiling or crying."
  },
  {
    "key": "evt_CK07S_0006",
    "original": "",
    "translation": "Or you getting mad, Mikuru."
  },
  {
    "key": "evt_CK07S_0007",
    "original": "",
    "translation": "Even I get angry sometimes, you know?"
  },
  {
    "key": "evt_CK07S_0008",
    "original": "",
    "translation": "Or even Kyon crying."
  },
  {
    "key": "evt_CK07S_0009",
    "original": "",
    "translation": "Have you ever seen that?"
  },
  {
    "key": "evt_CK07S_0010",
    "original": "",
    "translation": "Never."
  },
  {
    "key": "evt_CK07S_0011",
    "original": "",
    "translation": "Or maybe Koizumi screaming out in rage."
  },
  {
    "key": "evt_CK07S_0012",
    "original": "",
    "translation": "…That sounds scary."
  },
  {
    "key": "evt_CK07S_0013",
    "original": "",
    "translation": "I'd love to see something like that though."
  },
  {
    "key": "evt_CK07S_0014",
    "original": "",
    "translation": "If it were just for a moment, maybe I'd also\nwant to…"
  }
]